# 服务配置
DEBUG=false
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Shanghai

# 本地标注台（0-10 分）
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8100
DATASETS_DIR=data/datasets

# HTTP API 鉴权（公网部署务必设置 Token 并开启校验）
# 本地调试可留空；systemd 部署请放进 /etc/yumababy/env 而不是项目目录
API_TOKEN=
API_AUTH_REQUIRED=false

# QQ Bot (NapCatQQ / OneBot v11)
QQ_ENABLED=false
# onebot = NapCat/OneBot；official = QQ 开放平台机器人
QQ_PROVIDER=onebot
QQ_WS_URL=ws://127.0.0.1:3001
QQ_OFFICIAL_APP_ID=
QQ_OFFICIAL_APP_SECRET=
QQ_OFFICIAL_API_BASE=https://api.bot.qq.com
QQ_OFFICIAL_INTENTS=33554432
QQ_OFFICIAL_BOT_OPENID=
QQ_ACCESS_TOKEN=
QQ_TARGET_GROUPS=123456789,987654321
# 只读群：只记录消息，永不发言
QQ_READONLY_GROUPS=
# 每晚 23:40 分析这些群的聊天特征，私聊给管理员
GROUP_ANALYSIS_GROUPS=
# 机器人自身 QQ 号，用于识别 @ 和过滤自发消息
QQ_BOT_UID=
# 命中这些关键词（或 @机器人）才会在群里回复，留空表示只响应 @
QQ_AUTO_REPLY_KEYWORDS=小弗,小鱼
# 接收人设审核清单的管理员 QQ
QQ_PERSONA_ADMIN=
# 允许私聊的用户（逗号分隔），管理员始终允许；留空 = 只有管理员能私聊
QQ_PRIVATE_WHITELIST=
# 群里何时响应：mention | keyword | mention_or_keyword | all
GROUP_TRIGGER_MODE=mention_or_keyword
GROUP_NAME_MENTION=false
FOLLOWUP_ENABLED=true
FOLLOWUP_WINDOW_SECONDS=120
FOLLOWUP_MAX_TURNS=3
FOLLOWUP_GROUP_COOLDOWN_SECONDS=3
# 自动旁听接话的群（@ 与关键词仍必定回复）；留空 = 不自动接话
QQ_PARTICIPATION_GROUPS=
PARTICIPATION_RATE=0.1
PARTICIPATION_QUESTION_ONLY=true5
PARTICIPATION_COOLDOWN_SECONDS=120
# 群聊短期上下文（被 @ 时回看最近消息）
GROUP_CONTEXT_ENABLED=true
GROUP_CONTEXT_MAX=300
GROUP_CONTEXT_MINUTES=30
GROUP_CONTEXT_INJECT=10
GROUP_CONTEXT_KEEP_DAYS=3
# 群聊总结
SUMMARY_ADMIN_ONLY=false
SUMMARY_DEFAULT_COUNT=50
SUMMARY_MAX_COUNT=120
SUMMARY_COOLDOWN_SECONDS=600
SUMMARY_DAILY_LIMIT=10
# 表情收藏（仅管理员）
STICKERS_DIR=data/stickers
STICKER_CANDIDATES_DIR=data/sticker_candidates
STICKER_COLLECT_ENABLED=false
STICKER_COLLECT_GROUPS=
STICKER_COLLECT_USERS=
STICKER_COLLECT_MAX_PER_DAY=20
STICKER_SEND_MODE=manual
STICKER_SEND_CHANCE=0
STICKER_SEND_COOLDOWN_SECONDS=60
STICKER_SEND_DAILY_LIMIT=0
STICKER_SEND_MIN_CHARS=4
STICKER_TONE_MAP=无语:大狗无语
STICKER_SEND_GROUPS=
STICKER_MAX_BYTES=5000000
STICKER_LOOKBACK_MINUTES=10
# 连发合并：同一会话窗口内的多条消息合并成一次处理；0 = 关闭
DEBOUNCE_SECONDS=1.5
DEBOUNCE_MAX_CHARS=400
DEBOUNCE_MAX_MESSAGES=5

# Agent（M1）
AGENT_ENABLED=true
AGENT_MAX_STEPS=6
AGENT_MAX_TOKENS=300
AGENT_HISTORY_TURNS=8
AGENT_MEMORY_LIMIT=5
# 会话压缩
HISTORY_COMPACT_ENABLED=false
HISTORY_COMPACT_AFTER=30
HISTORY_COMPACT_KEEP=12
# 沙箱文件工具（仅管理员私聊）
SANDBOX_ENABLED=false
SANDBOX_ROOT=data/sandbox
SANDBOX_MAX_READ_BYTES=200000
SANDBOX_MAX_WRITE_BYTES=1000000
MEMORY_DECAY_DAYS=30
MEMORY_MAX_PER_SCOPE=200
MEMORY_DB=data/memory.db
# 记忆提炼（A0）：每 N 条消息后台提炼一次
MEMORY_EXTRACT_ENABLED=false
MEMORY_EXTRACT_EVERY=10
MEMORY_EXTRACT_MAX_MESSAGES=40
MEMORY_EXTRACT_DAILY_LIMIT=20
# 主题软分层（C）
MEMORY_HIERARCHY_ENABLED=false
AGENT_MEMORY_TOPICS=3
MEMORY_TOPICS_MAX=50
MEMORY_TOPIC_SUMMARY_MIN_FACTS=5
# 向量检索（A1）：需要 OpenAI 兼容 embedding；DeepSeek 没有 embedding
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT=15

# 网页抓取
WEB_FETCH_TIMEOUT=15
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_MAX_CHARS=4000
WEB_SEARCH_PROVIDER=deepseek

# 图片理解（把图片喂给多模态模型）
VISION_ENABLED=true
VISION_MAX_IMAGES=2
VISION_CONTEXT_IMAGES=1
VISION_MAX_BYTES=5000000
VISION_TIMEOUT=15

# 数据 / 缓存
STOCK_DATA_SOURCE=akshare
CACHE_TTL=300

# 股票行情播报（股票功能整体搁置中，默认关闭）
MARKET_PUSH_ENABLED=false

# 人设审核
PERSONA_FEEDBACK_TTL_MINUTES=180
PERSONA_PUSH_IDLE_SECONDS=0
PERSONA_ANALYZE_DAILY_LIMIT=20
PERSONA_MAX_PENDING=20

# 日志
LOG_LEVEL=INFO
LOG_FILE=data/logs/yumababy.log
LOG_MAX_BYTES=5000000
LOG_BACKUPS=5

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=30
LLM_MAX_TOKENS=800
LLM_THINKING=disabled

# 用量与预算（元；单价按每百万 token）
LLM_PRICE_INPUT_PER_M=2
LLM_PRICE_OUTPUT_PER_M=8
DAILY_BUDGET_SOFT=10
DAILY_BUDGET_HARD=30
