# 服务配置
DEBUG=false
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Shanghai

# 本地标注台（0-10 分）
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8100
DATASETS_DIR=data/datasets

# HTTP API 鉴权（公网部署务必设置 Token 并开启校验）
# 本地调试可留空；systemd 部署请放进 /etc/yumababy/env 而不是项目目录
API_TOKEN=
API_AUTH_REQUIRED=false

# QQ Bot (NapCatQQ / OneBot v11)
QQ_ENABLED=false
QQ_WS_URL=ws://127.0.0.1:3001
QQ_ACCESS_TOKEN=
QQ_TARGET_GROUPS=123456789,987654321
# 机器人自身 QQ 号，用于识别 @ 和过滤自发消息
QQ_BOT_UID=
# 命中这些关键词（或 @机器人）才会在群里回复，留空表示只响应 @
QQ_AUTO_REPLY_KEYWORDS=小鱼
# 接收人设审核清单的管理员 QQ
QQ_PERSONA_ADMIN=
# 允许私聊的用户（逗号分隔），管理员始终允许；留空 = 只有管理员能私聊
QQ_PRIVATE_WHITELIST=
# 群里何时响应：mention | keyword | mention_or_keyword | all
GROUP_TRIGGER_MODE=mention_or_keyword
# 自动旁听接话的群（@ 与关键词仍必定回复）；留空 = 不自动接话
QQ_PARTICIPATION_GROUPS=
PARTICIPATION_RATE=0.15
PARTICIPATION_COOLDOWN_SECONDS=120
# 群聊短期上下文（被 @ 时回看最近消息）
GROUP_CONTEXT_ENABLED=true
GROUP_CONTEXT_MAX=50
GROUP_CONTEXT_MINUTES=30
GROUP_CONTEXT_INJECT=10
# 表情收藏（仅管理员）
STICKERS_DIR=data/stickers
STICKER_MAX_BYTES=5000000
STICKER_LOOKBACK_MINUTES=10
# 连发合并：同一会话窗口内的多条消息合并成一次处理；0 = 关闭
DEBOUNCE_SECONDS=1.5
DEBOUNCE_MAX_CHARS=400
DEBOUNCE_MAX_MESSAGES=5

# Agent（M1）
AGENT_ENABLED=true
AGENT_MAX_STEPS=6
AGENT_MAX_TOKENS=300
AGENT_HISTORY_TURNS=8
AGENT_MEMORY_LIMIT=5
MEMORY_DECAY_DAYS=30
MEMORY_MAX_PER_SCOPE=200
MEMORY_DB=data/memory.db

# 网页抓取
WEB_FETCH_TIMEOUT=15
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_MAX_CHARS=4000

# 图片理解（把图片喂给多模态模型）
VISION_ENABLED=true
VISION_MAX_IMAGES=2
VISION_CONTEXT_IMAGES=1
VISION_MAX_BYTES=5000000
VISION_TIMEOUT=15

# 数据 / 缓存
STOCK_DATA_SOURCE=akshare
CACHE_TTL=300

# 股票行情播报（股票功能整体搁置中，默认关闭）
MARKET_PUSH_ENABLED=false

# 人设审核
PERSONA_FEEDBACK_TTL_MINUTES=180
PERSONA_ANALYZE_DAILY_LIMIT=20
PERSONA_MAX_PENDING=20

# 日志
LOG_LEVEL=INFO

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_TOKENS=800

# 用量与预算（元；单价按每百万 token）
LLM_PRICE_INPUT_PER_M=2
LLM_PRICE_OUTPUT_PER_M=8
DAILY_BUDGET_SOFT=10
DAILY_BUDGET_HARD=30
